{
  "name": "opennext-r2-janitor",
  "version": "0.1.0",
  "description": "Delete stale per-build incremental cache entries that OpenNext for Cloudflare leaves behind in R2",
  "keywords": [
    "opennext",
    "cloudflare",
    "workers",
    "r2",
    "nextjs",
    "isr",
    "cache"
  ],
  "license": "MIT",
  "author": "Hidetaka Okamoto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/opennext-r2-janitor.git"
  },
  "homepage": "https://github.com/hideokamoto/opennext-r2-janitor#readme",
  "bugs": "https://github.com/hideokamoto/opennext-r2-janitor/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public"
  }
}
